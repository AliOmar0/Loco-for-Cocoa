{
  "name": "loco-for-cocoa",
  "version": "2.0.0",
  "description": "A cinematic React and native WebGL recipe experience for sweet things.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:server && tsc -b && vite build",
    "build:pages": "npm run typecheck:server && tsc -b && vite build --base=/Loco-for-Cocoa/",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:smoke": "node tests/react-smoke.mjs",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "auth:hash": "node scripts/hash-owner-password.mjs",
    "auth:secret": "node scripts/generate-jwt-secret.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AliOmar0/Loco-for-Cocoa.git"
  },
  "keywords": [
    "recipes",
    "react",
    "webgl",
    "glsl"
  ],
  "author": "Loco for Cocoa",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AliOmar0/Loco-for-Cocoa/issues"
  },
  "homepage": "https://aliomar0.github.io/Loco-for-Cocoa/",
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@vercel/blob": "^2.4.0",
    "canvas-confetti": "^1.9.4",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "react-router-dom": "^7.17.0",
    "three": "^0.184.0",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16"
  }
}
