# Public frontend value. On GitHub Pages, set this as an Actions variable.
VITE_API_URL=https://your-project.vercel.app

# Private Vercel variables. Never prefix these with VITE_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://aliomar0.github.io,http://127.0.0.1:5173
OWNER_EMAIL=you@example.com
OWNER_NAME=Ali
OWNER_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$replace-me

# Private AI provider variables used only by authenticated Studio Functions.
EPICURE_MCP_URL=https://epicure-mcp.kaikaku.ai/mcp
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-pro
USDA_API_KEY=replace-with-your-fooddata-central-key
# Free community image key. Sign-up does not require a card or payment.
POLLINATIONS_API_KEY=replace-with-your-free-pollinations-key
# Optional paid fallback only.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
